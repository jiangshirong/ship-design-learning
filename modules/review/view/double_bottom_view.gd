extends Control
# Teaching projections of study_cargo_inspection.glb, generated by
# tools/build_inspection_models.py. Coordinates: x longitudinal, y vertical.
# No numerical dimensions or capacity are claimed for the original Q12.
const BLUE=Color("77bde8")
const GOLD=Color("f3c677")
const INK=Color("dce8ee")
const MUTED=Color("718b9c")
var lesson_id:="Q12"
var phase:="locate"
var language:="zh"
var state:Dictionary={}
var camera_motion:=false
var camera_tween:Tween
var camera_target:=Vector3(0,.15,0)
var camera_span:=7.0
var yaw:=.35
var pitch:=.20
var dragging:=false
var port:SubViewportContainer
var viewport:SubViewport
var world:Node3D
var camera:Camera3D
var detailed:Node3D
var section:MeshInstance3D
var volume:MeshInstance3D
var bounds:Node3D
var hull_ring:Node3D
var inspection=preload("res://view/inspection_cut.gd").new()
var label_lookup=preload("res://modules/review/view/drawn_term_lookup.gd").new()

func tr2(zh:String,ru:String)->String:return zh if language=="zh" else ru
func value(key:String)->float:return float(state.get("db_"+key,0.0))
static func half_width(x:float)->float:
	var s:=x+10.0
	return 1.5*maxf(.025,minf(minf(pow(maxf(s,0)/2.44,.55),pow(maxf(20-s,0)/3.3,.62)),1.0))
static func hull_section(x:float)->PackedVector2Array:
	var result:=PackedVector2Array()
	for p in [Vector2(-1,1),Vector2(-1,.4),Vector2(-.98,.15),Vector2(-.9,0),Vector2(0,0),Vector2(.9,0),Vector2(.98,.15),Vector2(1,.4),Vector2(1,1)]:
		result.append(Vector2(p.x*half_width(x),-.4+p.y*2.4))
	return result
func material(c:Color,alpha:=1.0)->StandardMaterial3D:
	var m:=StandardMaterial3D.new();m.albedo_color=Color(c,alpha);m.roughness=.65
	if alpha<1:m.transparency=BaseMaterial3D.TRANSPARENCY_ALPHA;m.cull_mode=BaseMaterial3D.CULL_DISABLED
	return m
func box(dim:Vector3,p:Vector3,c:Color,parent:Node,alpha:=1.0)->MeshInstance3D:
	var n:=MeshInstance3D.new();var mesh:=BoxMesh.new();mesh.size=dim;n.mesh=mesh;n.position=p;n.material_override=material(c,alpha);parent.add_child(n);return n
func _ready()->void:
	mouse_filter=Control.MOUSE_FILTER_IGNORE
	port=SubViewportContainer.new();port.stretch=true;port.show_behind_parent=true;port.mouse_filter=Control.MOUSE_FILTER_STOP;add_child(port);port.gui_input.connect(orbit)
	viewport=SubViewport.new();viewport.own_world_3d=true;viewport.msaa_3d=Viewport.MSAA_8X;port.add_child(viewport)
	world=Node3D.new();viewport.add_child(world)
	var env:=WorldEnvironment.new();env.environment=Environment.new();env.environment.background_mode=Environment.BG_COLOR;env.environment.background_color=Color("122735");env.environment.ambient_light_source=Environment.AMBIENT_SOURCE_COLOR;env.environment.ambient_light_color=Color("c4dcec");env.environment.ambient_light_energy=.8;world.add_child(env)
	for angles in [Vector3(-50,-35,0),Vector3(-15,140,0)]:
		var light:=DirectionalLight3D.new();light.rotation_degrees=angles;light.light_energy=.8;world.add_child(light)
	camera=Camera3D.new();camera.projection=Camera3D.PROJECTION_ORTHOGONAL;camera.far=100;world.add_child(camera)
	detailed=load("res://assets/study_cargo_inspection.glb").instantiate();world.add_child(detailed);inspection.attach(detailed)
	# Cut the near half of the inner bottom together with the near shell;
	# keep the far half and the outer bottom, so the cavity remains legible.
	for node in inspection.nodes:
		if str(node.name).begins_with("InnerBottom"):
			for i in node.mesh.get_surface_count():node.get_surface_override_material(i).set_shader_parameter("role",1)
	bounds=Node3D.new();world.add_child(bounds)
	for x in [-4.,4.]:box(Vector3(.045,.4,2.14),Vector3(x,-.2,0),Color("b4b4ac"),bounds)
	box(Vector3(8,.4,.035),Vector3(0,-.2,-1.07),Color("b4b4ac"),bounds)
	# The near boundary is cut with the shell; keep its edge, not an opaque
	# replacement wall in front of the very compartment being explained.
	for y in [-.4,0.]:box(Vector3(8,.018,.018),Vector3(0,y,1.07),Color("b4b4ac"),bounds)
	section=box(Vector3(.028,.4,2.14),Vector3(-4,-.2,0),GOLD,world,.75)
	volume=box(Vector3(1,.4,2.14),Vector3(0,-.2,0),GOLD,world,.36)
	hull_ring=Node3D.new();world.add_child(hull_ring)
	var outline:=hull_section(0)
	for i in range(outline.size()-1):
		var a:=Vector3(0,outline[i].y,outline[i].x);var b:=Vector3(0,outline[i+1].y,outline[i+1].x)
		var n:=MeshInstance3D.new();var cylinder:=CylinderMesh.new();cylinder.top_radius=.018;cylinder.bottom_radius=.018;cylinder.height=a.distance_to(b);n.mesh=cylinder;n.material_override=material(GOLD);hull_ring.add_child(n);n.position=(a+b)*.5
		n.quaternion=Quaternion(Vector3.UP,(b-a).normalized())
	add_child(label_lookup);resized.connect(arrange);arrange()
func arrange()->void:
	if not port:return
	port.position=Vector2(12,120);port.size=Vector2(size.x*.47-20,size.y*.61)
	update_camera();queue_redraw()
func update_camera()->void:
	if not camera:return
	camera.size=maxf(camera_span,11.0/maxf(port.size.x/maxf(port.size.y,1),.4))
	camera.position=camera_target+Vector3(sin(yaw)*cos(pitch),sin(pitch),cos(yaw)*cos(pitch))*20
	camera.look_at(camera_target);queue_redraw()
func project(p:Vector3)->Vector2:return port.position+camera.unproject_position(p)*port.size/Vector2(viewport.size)
func apply(s:Dictionary,focus:String,lang:String)->void:
	if state==s and phase==focus and language==lang:return
	state=s.duplicate();phase=focus;language=lang
	inspection.window(value("cut"),0,4.2,-.38,-.15,0)
	bounds.visible=value("cut")>.01
	section.visible=value("station")>0
	section.position.x=lerpf(-4,0,value("station")) if value("sweep")==0 else lerpf(-4,4,value("sweep"))
	hull_ring.visible=section.visible;hull_ring.position.x=section.position.x
	volume.visible=value("match")>0
	var length_:float=8*value("sweep") if phase in ["volume","answer"] else .04
	volume.scale.x=maxf(length_,.001);volume.position.x=-4+length_*.5 if phase in ["volume","answer"] else 0
	queue_redraw()
func teach(_focus:String)->void:pass
func cancel()->void:dragging=false;camera_motion=false
func orbit(event:InputEvent)->void:
	if event is InputEventMouseButton:
		if event.button_index==MOUSE_BUTTON_LEFT:dragging=event.pressed;port.accept_event()
		elif event.pressed and event.button_index in [MOUSE_BUTTON_WHEEL_UP,MOUSE_BUTTON_WHEEL_DOWN]:
			camera_span=clampf(camera_span*(.9 if event.button_index==MOUSE_BUTTON_WHEEL_UP else 1.1),2,20);update_camera();port.accept_event()
	elif event is InputEventMouseMotion and dragging:
		yaw-=event.relative.x*.005;pitch=clampf(pitch+event.relative.y*.005,-1.52,1.52);update_camera();port.accept_event()
func panel(index:int)->Rect2:
	return Rect2(size.x*.49,120+index*(size.y-146)*.5,size.x*.49-12,(size.y-166)*.5)
func anchor()->Vector2:
	if phase=="lines":return panel(0).position+Vector2(panel(0).size.x*.40,panel(0).size.y*.65)
	if phase=="inner":return panel(1).position+Vector2(panel(1).size.x*.12,75)
	if phase=="match":return panel(1).position+Vector2(panel(1).size.x*.50,panel(1).size.y*.78+minf(panel(1).size.x*.16,panel(1).size.y*.7)*.2)
	return project(Vector3(section.position.x if section.visible else 0,-.2,1.07))
func obstacles()->Array:
	var result:Array=[Rect2(port.position,port.size*.92)]
	if value("lines")>0:result.append(panel(0))
	if value("inner")>0:result.append(panel(1))
	return result
func text_at(t:String,p:Vector2,c:=INK,fs:=20)->void:
	draw_string(get_theme_font("font"),p,t,HORIZONTAL_ALIGNMENT_LEFT,-1,fs,c)
	label_lookup.add_label(t,p,get_theme_font("font"),fs)
func trace(points:PackedVector2Array,color:Color,amount:=1.,width:=2.)->void:
	if points.size()<2 or amount<=0:return
	var count:float=(points.size()-1)*clampf(amount,0,1)
	for i in int(ceil(count)):
		draw_line(points[i],points[i].lerp(points[i+1],minf(count-i,1)),color,width,true)
func profile(origin:Vector2,scale_:float,x:float,color:Color,amount:=1.,width:=2.)->void:
	var points:=PackedVector2Array()
	for p in hull_section(x):points.append(origin+Vector2(p.x,-p.y)*scale_)
	trace(points,color,amount,width)
func _draw()->void:
	label_lookup.clear_labels()
	var fs:=18 if size.x<1200 else 20
	if value("cut")>.8:
		var p:=project(Vector3(1,0,1.07));draw_line(p,p+Vector2(0,-35),GOLD,2,true);text_at(tr2("内底","Вну́треннее дно"),p+Vector2(-40,-43),GOLD,fs)
		p=project(Vector3(1,-.4,1.07));draw_line(p,p+Vector2(0,45),BLUE,2,true);text_at(tr2("外底","Нару́жное дно"),p+Vector2(-40,68),BLUE,fs)
	if value("lines")>0:draw_lines_plan(fs)
	if value("inner")>0:draw_inner_plan(fs)
func draw_lines_plan(fs:int)->void:
	var r:=panel(0);draw_rect(r,Color("193443"));draw_rect(r,Color("3b596a"),false,1)
	text_at(tr2("型线图","Теорети́ческий чертёж"),r.position+Vector2(16,30),BLUE,fs+1)
	var origin:=r.position+Vector2(r.size.x*.24,r.size.y*.78)
	var sc:float=minf(r.size.x*.13,r.size.y*.25)
	for x in [-9.,-8.,-7.,-4.,0.,7.,8.,9.]:profile(origin,sc,x,BLUE*.65,value("lines"),1.)
	text_at(tr2("横剖线","Шпанго́уты"),r.position+Vector2(16,58),INK,fs)
	var left:=r.position.x+r.size.x*.51;var w:=r.size.x*.44
	var y:=r.position.y+r.size.y*.36
	text_at(tr2("侧投影","Бок"),Vector2(left,y-13),INK,fs)
	trace(PackedVector2Array([Vector2(left,y),Vector2(left+w,y),Vector2(left+w,y+34),Vector2(left,y+34),Vector2(left,y)]),BLUE,value("lines"),1.5)
	# Longitudinal sections at fixed transverse distances, derived from the
	# exact same piecewise hull profile rather than arbitrary decorative curves.
	for z in [.75,1.25]:
		var buttock:=PackedVector2Array()
		for i in 161:
			var x:float=-10+i*.125;var hw:=half_width(x)
			if z>hw:continue
			var h:float=-.4
			if z>hw*.98:h=lerpf(-.04,.56,(z/hw-.98)/.02)
			elif z>hw*.9:h=lerpf(-.4,-.04,(z/hw-.9)/.08)
			buttock.append(Vector2(left+i/160.*w,y+34-(h+.4)/2.4*34))
		trace(buttock,BLUE*.65,value("lines"),1.)
	var py:=r.position.y+r.size.y*.76
	text_at(tr2("半宽投影","Полуширота́"),Vector2(left,py-38),INK,fs)
	for factor in [.9,.98,1.]:
		var points:=PackedVector2Array()
		for i in 81:
			var x:float=-10+i*.25;points.append(Vector2(left+i/80.*w,py-half_width(x)*19*factor))
		trace(points,BLUE,value("lines"),1.5)
	draw_line(Vector2(left,py),Vector2(left+w,py),MUTED,1,true)
	if value("station")>0:
		var x:float=section.position.x;profile(origin,sc,x,GOLD,1,3)
		var sx:float=left+(x+10)/20*w
		draw_line(Vector2(sx,y-4),Vector2(sx,py+6),GOLD,2,true)
		text_at("S",Vector2(sx+5,y+24),GOLD,fs)
		text_at("S",origin+Vector2(sc*1.5+7,-sc),GOLD,fs)
func draw_inner_plan(fs:int)->void:
	var r:=panel(1);draw_rect(r,Color("193443"));draw_rect(r,Color("3b596a"),false,1)
	text_at(tr2("双层底图","Чертёж двойно́го дна"),r.position+Vector2(16,30),GOLD,fs+1)
	var rect:=Rect2(r.position+Vector2(r.size.x*.12,58),Vector2(r.size.x*.76,r.size.y*.23))
	trace(PackedVector2Array([rect.position,rect.position+Vector2(rect.size.x,0),rect.end,rect.position+Vector2(0,rect.size.y),rect.position]),GOLD,value("inner"),2.5)
	for i in range(1,8):
		var x:float=rect.position.x+rect.size.x*i/8.
		draw_line(Vector2(x,rect.position.y),Vector2(x,rect.end.y),MUTED*.6,1,true)
	text_at(tr2("两端舱壁之间","Ме́жду перебо́рками"),rect.position+Vector2(0,rect.size.y+24),GOLD,fs)
	var station_x:float=rect.position.x+(section.position.x+4)/8*rect.size.x
	draw_line(Vector2(station_x,rect.position.y-5),Vector2(station_x,rect.end.y+5),GOLD,3,true);text_at("S",Vector2(station_x+6,rect.position.y+23),GOLD,fs)
	var sc:float=minf(r.size.x*.16,r.size.y*.7)
	var origin:=r.position+Vector2(r.size.x*.50,r.size.y*.78)
	# Same scale and same station: merge the outer bottom from the lines plan
	# with the inner bottom and longitudinal boundaries from this drawing.
	var area:=Rect2(origin+Vector2(-1.07,0)*sc,Vector2(2.14,.4)*sc)
	draw_line(area.position,area.position+Vector2(area.size.x,0),GOLD,3,true)
	draw_line(area.position,area.position+Vector2(0,area.size.y),GOLD,2,true)
	draw_line(area.position+Vector2(area.size.x,0),area.end,GOLD,2,true)
	if phase=="match" or value("match")>0:
		var source:=panel(0)
		var source_origin:=source.position+Vector2(source.size.x*.24,source.size.y*.78)
		var source_scale:float=minf(source.size.x*.13,source.size.y*.25)
		var left:Vector2=(source_origin+Vector2(-1.35,.4)*source_scale).lerp(origin+Vector2(-1.35,.4)*sc,value("match"))
		var right_:Vector2=(source_origin+Vector2(1.35,.4)*source_scale).lerp(origin+Vector2(1.35,.4)*sc,value("match"))
		draw_line(left,right_,BLUE,3,true)
		draw_rect(area,Color(GOLD,.25*value("match")))
		text_at("A",area.get_center()+Vector2(-5,7),INK,fs)
	text_at(tr2("截面 S","Сече́ние S"),Vector2(r.position.x+16,origin.y+9),INK,fs)
	if phase in ["volume","answer"]:
		draw_rect(Rect2(rect.position,Vector2(rect.size.x*value("sweep"),rect.size.y)),Color(GOLD,.28))
		for i in range(1,9):
			if value("sweep")>=i/8.:
				var x:float=rect.position.x+rect.size.x*i/8.;draw_line(Vector2(x,rect.position.y),Vector2(x,rect.end.y),GOLD,2,true)
