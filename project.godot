config_version=5
[application]
config/name="船舶原理学习"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
[display]
window/size/viewport_width=1440
window/size/viewport_height=900
window/size/window_width_override=1440
window/size/window_height_override=900
window/size/min_width=1100
window/size/min_height=760
window/subwindows/embed_subwindows=true
[rendering]
renderer/rendering_method="gl_compatibility"
anti_aliasing/quality/msaa_3d=3
environment/defaults/default_clear_color=Color(0.063,0.153,0.208,1)
[audio]
driver/enable_input=false
[gui]
timers/tooltip_delay_sec=0.0
