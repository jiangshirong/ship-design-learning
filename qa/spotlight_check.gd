extends "res://modules/review/qa/topics_check.gd"
func start(target)->void:
 host=target;app=host.review;page=app.stability
 await frames(8);host.open_review("reading");await frames(5)
 await app.open_topic("freeboard","M11Q06");await frames(5)
 select_beat("M11:M11Q06:protect");await settle_topic();await frames(12)
 var mask=page.bubble.spotlight
 var marine=page.topic_ship.active
 check(mask.visible,"Local spotlight visible during animation")
 check(mask.get_index()>page.topic_ship.get_index() and mask.get_index()<page.bubble.get_index(),"Mask above model below dialogue")
 check(mask.mouse_filter==Control.MOUSE_FILTER_IGNORE,"Mask does not intercept camera or controls")
 var c:Vector2=mask.material.get_shader_parameter("centre")
 var rad:Vector2=mask.material.get_shader_parameter("radii")
 check(c.distance_to(page.bubble.anchor)<1.,"Focus follows current model anchor")
 marine.camera.position+=Vector3(35,8,0);marine.camera.look_at(marine.turn_target);await frames(12)
 var changed:Vector2=mask.material.get_shader_parameter("centre")
 check(changed.distance_to(c)>5.,"Focus follows camera change")
 marine.camera.size*=.7;await frames(10)
 check((mask.material.get_shader_parameter("radii") as Vector2).x>rad.x,"Focus scales with camera zoom")
 check(page.bubble.panel.visible,"Dialogue remains visible")
 await capture("spotlight-forecastle")
 host.get_window().size=Vector2i(1100,760);await frames(12)
 check(mask.size==page.bubble.size,"Mask follows minimum window viewport")
 await capture("spotlight-minimum")
 tap(KEY_ESCAPE);await frames(8);check(not mask.is_visible_in_tree(),"Mask hidden on leaving lesson")
 await app.open_topic("propulsion");await frames(5)
 select_beat("R9:R9Q27:1");await settle_topic();await frames(10)
 check(page.bubble.spotlight.visible,"Propulsion explanation uses spotlight")
 await capture("spotlight-propulsion")
 tap(KEY_ESCAPE);await frames(6)
 await frames(8)
 host.ensure_lesson_ui();await frames(8)
 check(host.speech.spotlight!=null,"Original course has spotlight layer")
 check(host.speech.spotlight.get_index()<host.speech.get_index(),"Original course dialogue above mask")
 var f=FileAccess.open("res://qa/spotlight-results.json",FileAccess.WRITE);f.store_string(JSON.stringify(results,"  "));f.close()
 print("Spotlight checks ",results.size()," failures ",results.filter(func(r):return not r.passed).size())
 get_tree().quit()
