extends "res://qa/formal_check.gd"
func start(target)->void:
	app=target;await frames(5)
	for c in app.courses:
		for language in ["zh","ru"]:
			app.lang=language;await app.open_course(c.id,c.groups[0].beats[0].id);await settle()
			check(app.beat.id==c.id+":opening",c.id+" opens on problem/process/purpose")
			check(not app.right.visible,c.id+" no empty calculation pane")
			check(app.concept.visual=="roadmap" and app.beat.roadmap.size()==3,c.id+" three-stage route")
			check(app.concept.size==app.ship.size,c.id+" full-size teaching canvas")
			for label in app.concept.route_labels:
				check(label.get_v_scroll_bar().max_value<=label.get_v_scroll_bar().page,c.id+" "+language+" route text fits")
			check(app.speech.caption.get_v_scroll_bar().max_value<=app.speech.caption.get_v_scroll_bar().page,c.id+" "+language+" bubble fits")
			check(Rect2(Vector2.ZERO,app.speech.size).encloses(app.speech.panel.get_rect()),c.id+" "+language+" bubble within canvas")
			for rect in app.speech.protected_rects:
				check(not app.speech.panel.get_rect().intersects(rect),c.id+" "+language+" roadmap unoccluded")
			await capture("teaching-opening-"+c.id+"-"+language)
			var id:String=app.beat.id;tap(KEY_F2);await frames(8)
			check(app.beat.id==id and app.player.current==0,c.id+" F2 retains opening")
	app.lang="zh";await app.open_course("load","L01:equivalent");await settle()
	check(app.right.visible,"Equivalence calculation has right pane")
	check(app.equations.entries.has("L01:equivalent"),"Pair formula is recorded")
	check(absf((250.0*97+160*67)/410-85.29268292682927)<1e-10,"Pair is an interior weighted centre")
	await capture("teaching-weighted-centre")
	go_to("L01:moment_area")
	if app.ship.camera_tween:app.ship.camera_tween.custom_step(1)
	await frames(12);app.player.complete_busy();app.player.play();app.player.animation.custom_step(1.1)
	check(float(app.values.pair_measure)>0 and float(app.values.pair_measure)<1,"Centroid coordinate dimension has intermediate animation")
	await capture("teaching-moment-animation")
	go_to("L01:surface_effect");await settle();await capture("teaching-free-surface")
	check(float(app.values.surface_roll)==1,"Free surface demonstrates heel")
	go_to("L01:tank6");await settle();await capture("teaching-location")
	check(app.ship.fuel_locations.visible,"Whole-ship locator present in close-up")
	check(app.ship.fuel_locations.locator.size.x>400,"Locator readable at current size")
	for rect in app.speech.protected_rects:
		if rect==app.ship.fuel_locations.locator:check(not app.speech.panel.get_rect().intersects(rect),"Locator not covered by speech")
	go_to("L03:x")
	if app.ship.camera_tween:app.ship.camera_tween.custom_step(1)
	await frames(12)
	app.player.complete_busy();app.player.play();app.player.animation.custom_step(1.1)
	check(float(app.values.fuel_merge)>0 and float(app.values.fuel_merge)<1,"Nine contributions merge incrementally")
	for i in range(9):
		check(absf(app.ship.points[i].position.x+75-float(app.ship.fuel_layout[i].x_m))<.0001,"Aggregation never moves tank "+str(i+1))
	await capture("teaching-merge-animation")
	var moving:Dictionary=app.player.state.duplicate(true);app.toggle_language()
	check(app.player.state==moving,"F2 preserves partial aggregation")
	go_to("L04:carry");await settle()
	check(not app.state.merge_visible,"Next phase removes aggregation overlay")
	app.lang="zh";await app.open_course("mass","T03:power_dependency")
	if app.ship.camera_tween:app.ship.camera_tween.custom_step(1)
	await frames(12);app.player.complete_busy();app.player.play();app.player.animation.custom_step(1.1)
	check(float(app.values.dependency_reveal)>1 and float(app.values.dependency_reveal)<2,"Power dependency draws incrementally")
	await capture("teaching-dependency-animation")
	go_to("T03:fuel_dependency");await settle();await capture("teaching-dependency-complete")
	tap(KEY_ESCAPE);await frames(3);check(app.mode=="home","Escape returns home")
	check(app.get_window().get_flag(Window.FLAG_NO_FOCUS),"QA never takes focus")
	app.lang="ru";await app.open_course("dimensions","T16:pass");app.store.data.language="ru";app.save_progress()
	var output:=FileAccess.open("res://qa/teaching-"+("minimum" if "--minimum" in OS.get_cmdline_user_args() else "normal")+".json",FileAccess.WRITE)
	output.store_string(JSON.stringify(results,"\t"));output.close()
	print("TEACHING ",results.size()," checks")
	get_tree().quit(0 if results.all(func(r):return r.passed) else 1)
